{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "askfortask",
  "main": "src/worker.js",
  "build": { "command": "node scripts/build-studio-shell.mjs" },
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "triggers": {
    "crons": ["0 3 1 * *"]
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "askfortask_messages",
      "database_id": "9ae0b4d3-9310-4956-af90-c8d691b0d463"
    }
  ],
  "ratelimits": [
    {
      "name": "STUDIO_ACCESS_LIMIT",
      "namespace_id": "24901",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "vars": {
    "STUDIO_AUTH_URL": "https://gyrmucvbnzghbqiaaysj.supabase.co",
    "STUDIO_AUTH_PUBLISHABLE_KEY": "sb_publishable__MOGpnyfmrmfyAra15Jyug_Afirv6MS",
    "CONTACT_TO": "admin@askfortask.co.uk",
    "CONTACT_FROM": "A4T Studio <contact@askfortask.co.uk>"
  }
}
