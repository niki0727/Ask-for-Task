{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "askfortask",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "triggers": {
    "crons": ["0 3 1 * *"]
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "askfortask_messages",
      "database_id": "9ae0b4d3-9310-4956-af90-c8d691b0d463"
    }
  ],
  "vars": {
    "CONTACT_TO": "admin@askfortask.co.uk",
    "CONTACT_FROM": "A4T Studio <contact@askfortask.co.uk>"
  }
}
