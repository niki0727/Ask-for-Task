{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "askfortask",
  "main": "src/worker.js",
  "compatibility_date": "2026-05-03",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "askfortask_messages",
      "database_id": "9ae0b4d3-9310-4956-af90-c8d691b0d463"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "destination_address": "admin@askfortask.co.uk"
    }
  ]
}
